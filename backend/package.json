{
  "name": "auto-import-markt-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend für die Vergleichsseite Kfz-Importmärkte (Import nach Deutschland)",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --import tsx --watch --env-file-if-exists=.env src/server.ts",
    "start": "node --import tsx --env-file-if-exists=.env src/server.ts",
    "sync": "node --import tsx --env-file-if-exists=.env src/cli/sync.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "sync:turso": "node --import tsx --env-file=.env.turso src/cli/sync.ts",
    "check:xapikorea": "node --import tsx --env-file-if-exists=.env src/cli/check-xapikorea.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "@libsql/client": "^0.15.0",
    "fastify": "^5.3.2",
    "undici": "^7.29.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3"
  }
}
