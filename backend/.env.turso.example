# Sync vom eigenen Rechner direkt in die Produktions-Datenbank (Turso).
# Encar sperrt Rechenzentrums-IPs (Vercel/AWS), von einer Wohnsitz-IP funktioniert der Abruf.
# Kopie als backend/.env.turso anlegen (ist in .gitignore) und starten mit:  npm run sync:turso
#
# Werte aus Vercel → Settings → Environment Variables (Auge-Symbol zum Anzeigen):
TURSO_DATABASE_URL=libsql://auto-import-markt-....turso.io
TURSO_AUTH_TOKEN=

# Nur die Quellen, die von hier aus laufen sollen
ENABLE_MOCK_PROVIDER=false
ENCAR_ENABLED=true
ENCAR_MANUFACTURERS=현대,기아,제네시스
ENCAR_LIMIT_PER_MAKER=60
ENCAR_MIN_PRICE_MANWON=1000
ENCAR_MIN_YEAR=2012
ENCAR_DETAIL_CONCURRENCY=3
ENCAR_DELAY_MS=200
