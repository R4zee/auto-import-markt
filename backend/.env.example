# --- Server ---
PORT=4000
HOST=0.0.0.0
# Kommagetrennte Origins für CORS (Frontend-Dev-Server, Produktion)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Schutz für /api/admin/*  (leer = Admin-Routen deaktiviert)
ADMIN_KEY=
# Vercel Cron schützt /api/cron/sync mit diesem Secret (Authorization: Bearer …)
CRON_SECRET=

# --- Datenbank (libsql) ---
# lokal: SQLite-Datei relativ zu backend/ (oder :memory:)
DATABASE_PATH=./data/aim.sqlite
# Produktion (Vercel + Turso): werden von der Turso-Integration gesetzt
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Synchronisation ---
# Intervall in Minuten (0 = kein automatischer Sync; auf Vercel übernimmt der Cron aus vercel.json)
SYNC_INTERVAL_MIN=180
# Mock-Provider mit den 14 Beispieldaten aus dem Design (Entwicklung)
ENABLE_MOCK_PROVIDER=true

# --- Multi-Markt: Carapis Catalog API (https://api.carapis.com, Key car_… aus my.carapis.com) ---
CARAPIS_API_KEY=
# Quellcode:Markt – Codes via GET /api/admin/carapis/sources ("live" = laufend gecrawlt, "on_demand" = bei Carapis freischalten)
# Korea live: encar, kbchachacha, kcar, bobaedream · USA live: autotrader_us · Golf live: opensooq_ae
# Südeuropa live: automobile_it, standvirtual · Osteuropa live: autovit, olx_pl (otomoto on_demand)
# Japan live: goonet_exchange, carsensor – Inlandsware ist Rechtslenker und wird ohne LHD-Hinweis verworfen
CARAPIS_SOURCES=encar:KR,kbchachacha:KR,kcar:KR,autotrader_us:US,opensooq_ae:GCC,automobile_it:SE,autovit:EE
# Optional: nur diese Marken-Slugs je Sync (leer = alle)
CARAPIS_BRANDS=
CARAPIS_PAGE_SIZE=50
CARAPIS_PAGES=2
# Mindestpreis (USD, Carapis filtert in USD) und Sortierfeld (leer = API-Standard)
CARAPIS_MIN_PRICE_USD=4000
CARAPIS_ORDERING=
# Quelle für Referenzpreise im Zielmarkt (Detailansicht): kleinanzeigen ist live, mobile_de bei Carapis nur on_demand
CARAPIS_REFERENCE_SOURCE=kleinanzeigen

# --- USA: Apibara – Copart/IAAI-Auktionen (https://apibara.tech, Test-Plan 100 Req/Monat) ---
APIBARA_API_KEY=
APIBARA_PLATFORMS=copart,iaai
APIBARA_MAKE=
APIBARA_PAGES=2

# --- USA: MarketCheck (https://www.marketcheck.com/apis) ---
MARKETCHECK_API_KEY=
MARKETCHECK_MAKES=Toyota,Ford,Chevrolet,Dodge,Tesla

# --- USA/weltweit: eBay Motors Browse API (https://developer.ebay.com) ---
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US

# --- Südkorea: Encar direkt (öffentliche Frontend-Endpunkte, kein Key; Grauzone → bewusst aktivieren; über Carapis nicht nötig) ---
ENCAR_ENABLED=false
ENCAR_MANUFACTURERS=현대,기아,제네시스
ENCAR_IMPORTED_MAKERS=BMW,벤츠,아우디,폭스바겐,볼보,렉서스,토요타,포르쉐,테슬라,미니,랜드로버
ENCAR_LIMIT_PER_MAKER=40
ENCAR_MIN_PRICE_MANWON=1000
ENCAR_FETCH_DETAILS=true
ENCAR_DELAY_MS=250

# --- VAE: auto-api.com – Dubizzle/Dubicars (Zugang via access@auto-api.com) ---
AUTOAPI_ACCESS_NAME=
AUTOAPI_API_KEY=
AUTOAPI_SOURCES=dubizzle
AUTOAPI_PAGES=5

# --- Japan: Partner-/Exporteur-Feed (JSON). Feldzuordnung in src/providers/feed.ts ---
JP_FEED_URL=
JP_FEED_AUTH_HEADER=
JP_FEED_MAPPING=

# --- Wechselkurse (Frankfurter/EZB, kein Key nötig) ---
FX_BASE_URL=https://api.frankfurter.dev/v1
