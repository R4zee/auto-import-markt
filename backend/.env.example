# --- Server ---
PORT=4000
HOST=0.0.0.0
# Kommagetrennte Origins für CORS (Frontend-Dev-Server, Produktion)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Schutz für /api/admin/*  (leer = Admin-Routen deaktiviert)
ADMIN_KEY=
# Vercel Cron schützt /api/cron/sync mit diesem Secret (Authorization: Bearer …)
CRON_SECRET=

# --- Datenbank (libsql) ---
# lokal: SQLite-Datei relativ zu backend/ (oder :memory:)
DATABASE_PATH=./data/aim.sqlite
# Produktion (Vercel + Turso): werden von der Turso-Integration gesetzt
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Synchronisation ---
# Intervall in Minuten (0 = kein automatischer Sync; auf Vercel übernimmt der Cron aus vercel.json)
SYNC_INTERVAL_MIN=180
# Mock-Provider mit den 14 Beispieldaten aus dem Design (Entwicklung)
ENABLE_MOCK_PROVIDER=true
# CDN-Cache für öffentliche Lese-Antworten (/api/listings, /api/config …) in Sekunden; 0 = aus.
# Auf Vercel beantwortet das CDN wiederholte Suchen ohne Function-Aufruf (Bestand ändert sich nur per Sync).
API_CACHE_SECONDS=600

# --- USA: Apibara – Copart/IAAI-Auktionen (https://apibara.tech, Test-Plan 100 Req/Monat) ---
APIBARA_API_KEY=
APIBARA_PLATFORMS=copart,iaai
APIBARA_MAKE=
APIBARA_PAGES=2

# --- USA: MarketCheck (https://www.marketcheck.com/apis) ---
MARKETCHECK_API_KEY=
MARKETCHECK_MAKES=Toyota,Ford,Chevrolet,Dodge,Tesla

# --- USA/weltweit: eBay Motors Browse API (https://developer.ebay.com) ---
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US

# --- Südkorea: Encar direkt – Vollabgleich (Hauptquelle Korea; öffentliche Frontend-Endpunkte, kein Key) ---
# Läuft per GitHub Actions (.github/workflows/sync.yml) alle 6 h über den Residential-Proxy; auf Vercel aus lassen (300-s-Grenze).
ENCAR_ENABLED=true
# Y = koreanische Hersteller, N = Importmarken; optional auf Hersteller einschränken (koreanische Encar-Namen)
ENCAR_CAR_TYPES=Y,N
ENCAR_MANUFACTURERS=
ENCAR_IMPORTED_MAKERS=BMW,벤츠,아우디,폭스바겐,볼보,렉서스,토요타,포르쉐,테슬라,미니,랜드로버
# Mindestpreis in 만원 (1000 = 10 Mio. KRW), ältestes Baujahr → ca. 150.000 Inserate
ENCAR_MIN_PRICE_MANWON=1000
ENCAR_MIN_YEAR=2012
# Seitengröße (Encar-Max 500), Obergrenze je Teilabfrage (Encar: Offset+Limit ≤ 10.000), Testhilfe je Teilabfrage (0 = alle)
ENCAR_PAGE_SIZE=500
ENCAR_PARTITION_MAX=9500
ENCAR_LIMIT_PARTITION=0
# Detailabrufe je Lauf für neue Ausstattungskombinationen (englische Namen, Hubraum), Parallelität, Pause
ENCAR_DETAIL_LIMIT=1500
ENCAR_DETAIL_CONCURRENCY=4
# Parallel geladene Teilabfragen (Listen) – jede Anfrage kostet über den Proxy rund 1 s
ENCAR_LIST_CONCURRENCY=4
ENCAR_DELAY_MS=150
# Residential-Proxy (Wohnsitz-IP) – api.encar.com sperrt Rechenzentrums-IPs. Form: http://user:pass@host:port
ENCAR_PROXY_URL=

# --- Südkorea: xapikorea.com (Encar-Wrapper mit englischen Feldern, Fallback; Free 500 Req/Monat) ---
XAPIKOREA_API_KEY=
XAPIKOREA_BRANDS=Hyundai,Kia,Genesis
XAPIKOREA_PAGES=1
XAPIKOREA_MIN_PRICE_KRW=10000000
XAPIKOREA_FETCH_DETAILS=false
XAPIKOREA_DELAY_MS=250

# --- VAE: auto-api.com – Dubizzle/Dubicars (Zugang via access@auto-api.com) ---
AUTOAPI_ACCESS_NAME=
AUTOAPI_API_KEY=
AUTOAPI_SOURCES=dubizzle
AUTOAPI_PAGES=5

# --- Süd-/Osteuropa: kostenlose Frontend-Endpunkte der Portale (kein Key; Grauzone wie Encar, deshalb je Seite schaltbar) ---
# Vor dem Einschalten prüfen: npm run probe -- olx | subito | sauto  (zeigt Rohantwort + Zuordnung, schreibt nichts)
# Optionaler Residential-Proxy, falls eine Seite Rechenzentrums-IPs ablehnt (Form: http://user:pass@host:port)
EUROPE_PROXY_URL=
# OLX: Polen (olx.pl), Rumänien (olx.ro), Bulgarien (olx.bg), Portugal (olx.pt). Pkw-Kategorien vorbelegt und bestätigt (14.09.2026): PL 84, RO 84, BG 1117, PT 378.
# OLX_SITES nur zum Übersteuern, z. B. eine Seite abschalten: [{"country":"pt","enabled":false}]
OLX_ENABLED=false
OLX_SITES=
OLX_PAGES=25
OLX_PAGE_SIZE=40
# Mindestpreis je Seite vorbelegt (PL 20000 PLN; RO, BG, PT 5000 EUR – dort wird in EUR inseriert); OLX_MIN_PRICE überschreibt alle
OLX_MIN_PRICE=
OLX_MIN_YEAR=2012
OLX_DELAY_MS=400
# Subito.it (Italien): hades.subito.it, Kategorie Auto (c=2) – live bestätigt 14.09.2026, direkt aus Node erreichbar.
SUBITO_ENABLED=false
SUBITO_PAGES=30
SUBITO_PAGE_SIZE=100
SUBITO_REGIONS=
SUBITO_MIN_PRICE_EUR=5000
SUBITO_MIN_YEAR=2012
SUBITO_DELAY_MS=400
# Sauto.cz (Tschechien, Seznam): Kategorie 838 = Pkw, Preisfenster unter der 1.000er-Grenze je Abfrage
SAUTO_ENABLED=false
SAUTO_CATEGORY_ID=838
SAUTO_PAGES=5
SAUTO_PAGE_SIZE=200
SAUTO_MIN_PRICE_CZK=150000
SAUTO_MAX_BANDS=10
SAUTO_MIN_YEAR=2012
SAUTO_DELAY_MS=400

# --- USA: Copart-Suchendpunkt der Website (kein Login, kein Key; Grauzone wie Encar) ---
# Vorher prüfen: npm run probe -- copart   (zeigt Rohantwort des ersten Loses und die Zuordnung)
COPART_ENABLED=false
COPART_PAGES=5
COPART_PAGE_SIZE=100
# Optional auf Marken einschränken (Copart-Schreibweise): BMW,MERCEDES-BENZ,PORSCHE
COPART_MAKES=
COPART_MIN_YEAR=2012
COPART_DELAY_MS=800
COPART_PROXY_URL=

# --- Vergleichspreise DE (mobile.de-Web-App-Endpunkt, kein Key; Grauzone wie Encar) ---
# Zeigt auf jeder Kachel „DE ab €X“ und den Abstand des Endpreises inkl. TÜV in Prozent. Vorher prüfen:
#   npm run probe -- mobile BMW 320d 2019 Diesel
# Buckets (Marke, Variante, Kraftstoff, Baujahr ±1) lädt der Job `npm run reference` (GitHub Actions nach dem Sync);
# die API liest sie nur aus der Datenbank. Auf Vercel ebenfalls REFERENCE_ENABLED=true setzen, sonst bleibt die Kachel leer.
REFERENCE_ENABLED=false
# query = Suchparameter direkt an /consumer/api/search/srp; url = search.html-Adresse als Parameter (die Probe zeigt, was geht)
REFERENCE_MOBILE_MODE=query
REFERENCE_TTL_DAYS=7
REFERENCE_MAX_PER_RUN=1500
REFERENCE_PAGES=2
REFERENCE_DELAY_MS=700
REFERENCE_YEAR_SPAN=1
# Laufleistungsfenster: ±50 % unter 100.000 km, ±30 % darüber; Hubraum-Toleranz 12 %
REFERENCE_KM_THRESHOLD=100000
REFERENCE_KM_WINDOW_BELOW=0.5
REFERENCE_KM_WINDOW_ABOVE=0.3
REFERENCE_CCM_TOLERANCE=0.12
# Detailansicht darf fehlende Buckets live nachladen (eine mobile.de-Anfrage)
REFERENCE_LIVE_LOOKUP=true
# mobile.de-Marken-IDs ergänzen/übersteuern, z. B. {"Genesis":8501}
REFERENCE_MAKE_IDS=
REFERENCE_PROXY_URL=

# --- Partner-/Händler-Feeds (JSON-Array, ein Eintrag je Partner; Feldzuordnung in src/providers/feed.ts) ---
# Beispiel (eine Zeile): [{"id":"carpathia","label":"Carpathia (RO)","url":"https://partner.example/stock.json",
#   "country":"ro","authHeader":"Authorization: Bearer …","mapping":{"items":"cars","id":"id","year":"year","make":"brand",
#   "model":"model","km":"mileage","price":"price_eur","photos":"images","url":"link","location":"city"}}]
# Ohne "market" wird der Markt aus "country" abgeleitet (it/es/pt … → SE, pl/cz/ro … → EE). Quelle heißt dann "feed-<id>".
PARTNER_FEEDS=

# --- Japan: Einzel-Feed (bleibt als Quelle "jpfeed" erhalten; Alternative zu PARTNER_FEEDS) ---
JP_FEED_URL=
JP_FEED_AUTH_HEADER=
JP_FEED_MAPPING=

# --- Wechselkurse (Frankfurter/EZB, kein Key nötig) ---
FX_BASE_URL=https://api.frankfurter.dev/v1
