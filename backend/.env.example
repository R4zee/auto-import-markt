# --- Server ---
PORT=4000
HOST=0.0.0.0
# Kommagetrennte Origins für CORS (Frontend-Dev-Server, Produktion)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Schutz für /api/admin/*  (leer = Admin-Routen deaktiviert)
ADMIN_KEY=
# Vercel Cron schützt /api/cron/sync mit diesem Secret (Authorization: Bearer …)
CRON_SECRET=

# --- Datenbank (libsql) ---
# lokal: SQLite-Datei relativ zu backend/ (oder :memory:)
DATABASE_PATH=./data/aim.sqlite
# Produktion (Vercel + Turso): werden von der Turso-Integration gesetzt
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Synchronisation ---
# Intervall in Minuten (0 = kein automatischer Sync; auf Vercel übernimmt der Cron aus vercel.json)
SYNC_INTERVAL_MIN=180
# Mock-Provider mit den 14 Beispieldaten aus dem Design (Entwicklung)
ENABLE_MOCK_PROVIDER=true

# --- USA: Apibara – Copart/IAAI-Auktionen (https://apibara.tech, Test-Plan 100 Req/Monat) ---
APIBARA_API_KEY=
APIBARA_PLATFORMS=copart,iaai
APIBARA_MAKE=
APIBARA_PAGES=2

# --- USA: MarketCheck (https://www.marketcheck.com/apis) ---
MARKETCHECK_API_KEY=
MARKETCHECK_MAKES=Toyota,Ford,Chevrolet,Dodge,Tesla

# --- USA/weltweit: eBay Motors Browse API (https://developer.ebay.com) ---
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US

# --- Südkorea: Encar direkt – Vollabgleich (Hauptquelle Korea; öffentliche Frontend-Endpunkte, kein Key) ---
# Läuft per GitHub Actions (.github/workflows/sync.yml) alle 6 h über den Residential-Proxy; auf Vercel aus lassen (300-s-Grenze).
ENCAR_ENABLED=true
# Y = koreanische Hersteller, N = Importmarken; optional auf Hersteller einschränken (koreanische Encar-Namen)
ENCAR_CAR_TYPES=Y,N
ENCAR_MANUFACTURERS=
ENCAR_IMPORTED_MAKERS=BMW,벤츠,아우디,폭스바겐,볼보,렉서스,토요타,포르쉐,테슬라,미니,랜드로버
# Mindestpreis in 만원 (1000 = 10 Mio. KRW), ältestes Baujahr → ca. 150.000 Inserate
ENCAR_MIN_PRICE_MANWON=1000
ENCAR_MIN_YEAR=2012
# Seitengröße (Encar-Max 500), Obergrenze je Teilabfrage (Encar: Offset+Limit ≤ 10.000), Testhilfe je Teilabfrage (0 = alle)
ENCAR_PAGE_SIZE=500
ENCAR_PARTITION_MAX=9500
ENCAR_LIMIT_PARTITION=0
# Detailabrufe je Lauf für neue Ausstattungskombinationen (englische Namen, Hubraum), Parallelität, Pause
ENCAR_DETAIL_LIMIT=1500
ENCAR_DETAIL_CONCURRENCY=3
ENCAR_DELAY_MS=150
# Residential-Proxy (Wohnsitz-IP) – api.encar.com sperrt Rechenzentrums-IPs. Form: http://user:pass@host:port
ENCAR_PROXY_URL=

# --- Südkorea: xapikorea.com (Encar-Wrapper mit englischen Feldern, Fallback; Free 500 Req/Monat) ---
XAPIKOREA_API_KEY=
XAPIKOREA_BRANDS=Hyundai,Kia,Genesis
XAPIKOREA_PAGES=1
XAPIKOREA_MIN_PRICE_KRW=10000000
XAPIKOREA_FETCH_DETAILS=false
XAPIKOREA_DELAY_MS=250

# --- VAE: auto-api.com – Dubizzle/Dubicars (Zugang via access@auto-api.com) ---
AUTOAPI_ACCESS_NAME=
AUTOAPI_API_KEY=
AUTOAPI_SOURCES=dubizzle
AUTOAPI_PAGES=5

# --- Japan: Partner-/Exporteur-Feed (JSON). Feldzuordnung in src/providers/feed.ts ---
JP_FEED_URL=
JP_FEED_AUTH_HEADER=
JP_FEED_MAPPING=

# --- Wechselkurse (Frankfurter/EZB, kein Key nötig) ---
FX_BASE_URL=https://api.frankfurter.dev/v1
