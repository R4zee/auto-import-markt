# Basis-URL des Backends (leer = gleicher Origin / Vite-Proxy auf http://localhost:4000)
VITE_API_BASE=
# Händlermodus (Vergleichs-Checkbox, Marge, CSV-Export) standardmäßig aktivieren
VITE_DEALER_MODE=false
# Oberflächensprache beim ersten Besuch (de | en); Standard de
VITE_DEFAULT_LANGUAGE=de
VITE_DEFAULT_DESTINATION=DE
