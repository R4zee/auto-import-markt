{
  "name": "auto-import-markt",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18 <25"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "build": "npm run build -w frontend",
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "sync": "npm run sync -w backend",
    "test": "npm test -w backend",
    "typecheck": "npm run typecheck -w backend && npm run typecheck -w frontend",
    "sync:turso": "npm run sync:turso -w backend",
    "db:copy": "npm run db:copy -w backend --",
    "libsql:token": "npm run libsql:token -w backend"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "@libsql/client": "^0.15.0",
    "fastify": "^5.3.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.23.13",
    "typescript": "^5.8.3"
  }
}
